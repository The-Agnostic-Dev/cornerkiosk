<%- include('../partials/header') %>
<h1>Products</h1>
<% if (saved) { %><p class="flash success">Product saved.</p><% } %>
<table class="lines admin">
  <thead><tr><th>Name</th><th>Category</th><th class="num">Price</th><th class="num">Stock</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% products.forEach((p) => { %>
    <tr>
      <td><%= p.name %></td>
      <td><%= categories.find((c) => c.slug === p.category)?.name %></td>
      <td class="num"><%= money(p.pricePence) %></td>
      <td class="num"><%= p.stock %></td>
      <td><%= p.active ? stockLabel(p) : 'Hidden' %></td>
      <td><a href="/admin/products/<%= p.id %>/edit">Edit</a></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
